<?xml version="1.0" encoding="UTF-8"?>
<!--
  Placeholders substituted by install.sh (sed, `|` delimiter — paths may contain
  spaces and slashes):
    __LABEL__          launchd job label (also determines the installed filename)
    __CHECKER_PATH__   absolute path to libexec/auto-hotspot-check.sh
    __CHECK_INTERVAL__ seconds between checks
    __LOG_PATH__       stdout log (launchd-level, not the app log)
    __ERR_LOG_PATH__   stderr log (launchd-level, not the app log)

  Rendered output belongs at ~/Library/LaunchAgents/com.andrewwang.autohotspot.plist,
  mode 0644, owned by the user — never root.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>__LABEL__</string>
	<key>ProgramArguments</key>
	<array>
		<string>__CHECKER_PATH__</string>
	</array>
	<key>StartInterval</key>
	<integer>__CHECK_INTERVAL__</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>__LOG_PATH__</string>
	<key>StandardErrorPath</key>
	<string>__ERR_LOG_PATH__</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>LowPriorityIO</key>
	<true/>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
</dict>
</plist>
